# Copy to .env and fill in. The agent runs in DRY-RUN without these.

# Required for real content generation
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed when you wire up real publishing later.
# The MCP tools available in Claude Code (Buffer, Canva, Gmail, Drive) can
# handle these without keys here; these are for standalone/cron use.
# GUMROAD_ACCESS_TOKEN=
# BUFFER_ACCESS_TOKEN=

# ── Email sending (only needed for `email send --live`) ──────────────
# Any SMTP provider works. Gmail: create an App Password (2FA required) —
# your normal password will not work. Fastmail/SES/Postmark/Resend also fine.
# EMAIL_FROM=you@yourdomain.com
# EMAIL_FROM_NAME=Cowock
# EMAIL_REPLY_TO=you@yourdomain.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASSWORD=your-app-password
# SMTP_SSL=false          # true for implicit TLS on port 465
