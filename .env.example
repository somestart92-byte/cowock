# Copy to .env and fill in. Everything runs in DRY-RUN without these.

# Required for real copy generation (posts, video scripts).
# Without it the app still runs end to end using built-in templates.
ANTHROPIC_API_KEY=sk-ant-...

# Publishing needs NO platform API keys: posts are handed to the MCP servers
# already connected in your Claude Code session (Buffer, Canva, Drive…).

# Optional — voiceover for generated videos.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Optional overrides for the social app.
# SOCIAL_PUBLISH_MODE=dry_run      # dry_run | live
# SOCIAL_TIMEZONE=America/New_York
# SOCIAL_DB_PATH=data/social.db
